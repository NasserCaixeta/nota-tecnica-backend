APP_NAME=Nota Tecnica API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nota_tecnica
POSTGRES_USER=nota_tecnica
POSTGRES_PASSWORD=nota_tecnica
DATABASE_URL=postgresql+asyncpg://nota_tecnica:nota_tecnica@localhost:5432/nota_tecnica

REDIS_URL=redis://localhost:6379/0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
DOCUMENT_UPLOAD_URL_EXPIRES_SECONDS=900

JWT_SECRET_KEY=change-me-in-production-use-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chave exclusiva dos convites, pelo menos 32 caracteres aleatórios.
INVITATION_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Sandbox only. Disabled without explicit prices, API key and HTTPS callback host.
PAYMENTS_ENABLED=false
# PAYMENTS_HISTORY_PRICE_CENTS=1900
# PAYMENTS_SUBSCRIPTION_PRICE_CENTS=4900
PAYMENTS_CALLBACK_BASE_URL=
ASAAS_API_KEY=
# At least 32 random characters, distinct from the API key; required before offering checkout.
ASAAS_WEBHOOK_TOKEN=
# Set only after verifying the Sandbox event timezone; no implicit local timezone.
ASAAS_EVENT_TIMEZONE=

# Email disabled by default. Development uses only a local capture server.
SMTP_ENABLED=false
SMTP_CAPTURE_ONLY=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=piloto@nota-tecnica.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Local capture: docker compose --profile mail up -d mailpit
SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# Separate random secret (at least 32 chars); never put recovery tokens in logs.
RECOVERY_SECRET_KEY=
RECOVERY_IDENTITY_LIMIT=3
RECOVERY_IP_LIMIT=10
RECOVERY_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
LOGIN_IP_RATE_LIMIT=10
LOGIN_IDENTITY_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
QUERY_RATE_LIMIT=60
QUERY_RATE_WINDOW_SECONDS=60
INVITATION_RATE_LIMIT=10
INVITATION_RATE_WINDOW_SECONDS=3600
